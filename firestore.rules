rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contacts collection
    match /contacts/{documentId} {
      allow read: if false; // Only admin can read (via Firebase Console)
      allow create: if true; // Anyone can submit a contact form
      allow update: if false;
      allow delete: if false;
    }
    
    // Volunteers collection
    match /volunteers/{documentId} {
      allow read: if false; // Only admin can read
      allow create: if true; // Anyone can submit a volunteer form
      allow update: if false;
      allow delete: if false;
    }
  }
}
