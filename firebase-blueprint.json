{
  "collections": [
    {
      "name": "contacts",
      "description": "Stores contact form submissions from the website.",
      "securityRules": {
        "read": "false",
        "create": "true",
        "update": "false",
        "delete": "false"
      },
      "schema": {
        "name": "string",
        "email": "string",
        "message": "string",
        "createdAt": "timestamp"
      }
    },
    {
      "name": "volunteers",
      "description": "Stores volunteer applications.",
      "securityRules": {
        "read": "false",
        "create": "true",
        "update": "false",
        "delete": "false"
      },
      "schema": {
        "email": "string",
        "area_of_interest": "string",
        "availability": "string",
        "createdAt": "timestamp"
      }
    }
  ]
}
